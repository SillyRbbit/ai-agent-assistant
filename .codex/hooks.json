{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/post_increment_gate.py\" stop",
            "timeout": 30,
            "statusMessage": "Checking post-increment review"
          }
        ]
      }
    ]
  }
}
